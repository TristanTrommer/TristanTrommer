{
  "name": "tristantrommer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --ignore-path ~/.gitignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --ignore-path ~/.gitignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy-preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --ignore-path ~/.gitignore --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.1",
    "framer-motion": "^12.23.24",
    "next": "15.5.6",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.5.0",
    "react-turnstile": "^1.1.4",
    "react-type-animation": "^3.2.0",
    "react-vertical-timeline-component": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^3.8.5",
    "@opennextjs/cloudflare": "^1.11.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5",
    "wrangler": "^4.45.3"
  }
}
