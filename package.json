{
  "name": "tristantrommer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "dev": "next dev --turbopack",
    "lint": "next lint",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:deploy:preview": "npm run cf:build && opennextjs-cloudflare deploy --env preview",
    "format": "prettier --ignore-path ~/.gitignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --ignore-path ~/.gitignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --ignore-path ~/.gitignore --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.3",
    "motion": "^12.23.26",
    "next": "15.5.9",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.5.0",
    "react-turnstile": "^1.1.4",
    "react-type-animation": "^3.2.0",
    "react-vertical-timeline-component": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^3.9.6",
    "@opennextjs/cloudflare": "^1.14.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "wrangler": "^4.54.0"
  }
}
