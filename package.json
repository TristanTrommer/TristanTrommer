{
  "name": "tristantrommer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "dev": "next dev",
    "lint": "eslint .",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:deploy:preview": "npm run cf:build && opennextjs-cloudflare deploy --env preview",
    "format": "prettier --ignore-path .gitignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --ignore-path .gitignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --ignore-path .gitignore --write"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "motion": "^12.43.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-turnstile": "^1.1.5",
    "react-type-animation": "^3.2.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^4.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
