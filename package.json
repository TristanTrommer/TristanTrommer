{
  "name": "tristantrommer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "dev": "next dev",
    "lint": "eslint .",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:deploy:preview": "npm run cf:build && opennextjs-cloudflare deploy --env preview",
    "format": "prettier --ignore-path ~/.gitignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --ignore-path ~/.gitignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --ignore-path ~/.gitignore --write"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-turnstile": "^1.1.5",
    "react-type-animation": "^3.2.0"
  },
  "devDependencies": {
    "@opennextjs/aws": "^4.0.2",
    "@opennextjs/cloudflare": "^1.19.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "wrangler": "^4.92.0"
  }
}
